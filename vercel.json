{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "config/**",
                    "lib/**",
                    "routes/**"
                ]
            }
        },
        {
            "src": "api/**/*.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "config/**",
                    "lib/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/api/cron/(.*)",
            "dest": "/api/cron/$1"
        },
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/cron/reminder-today",
            "schedule": "0 2 * * *"
        },
        {
            "path": "/api/cron/reminder-overdue",
            "schedule": "0 2-9 * * *"
        }
    ]
}
